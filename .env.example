NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Admin panel (/admin) — lihat docs/admin-panel.md ----------
# Database Postgres (Neon). Di Vercel terisi otomatis setelah Neon dihubungkan di menu Storage.
# Kosong saat development → memakai database lokal otomatis (~/.partner-belajar/pglite).
# DATABASE_URL=postgres://...

# Penyimpanan foto (Vercel Blob). Di Vercel terisi otomatis setelah Blob dihubungkan
# (BLOB_STORE_ID untuk store baru, atau BLOB_READ_WRITE_TOKEN untuk store lama).
# Kosong saat development → foto disimpan di public/uploads.
# BLOB_READ_WRITE_TOKEN=...

# Kunci rahasia sesi login admin (wajib di production, minimal 32 karakter acak).
# AUTH_SECRET=

# Akun admin pertama — dibuat otomatis saat login pertama kali (hanya jika belum ada admin).
# ADMIN_EMAIL=admin@partnerbelajar.id
# ADMIN_PASSWORD=

# Opsional: teruskan data pendaftaran ke Google Sheets (lihat docs/tracking-pendaftaran.md)
# LEADS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
# LEADS_WEBHOOK_SECRET=kata-rahasia-panjang
